{
  "name": "miti",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "description": "Miti — Nepali-first offline calendar",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:assemble": "cd android && ./gradlew app:assembleDebug -x lint -x test",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prebuild:android": "expo prebuild --platform android",
    "seed:scrape": "python3 scripts/scrape-hamropatro-festivals.py",
    "seed:check": "npx tsx scripts/validate-festival-seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-crypto": "^57.0.3",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "uuid": "^13.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
