{
  "expo": {
    "name": "Miti",
    "slug": "miti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miti",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uplixor.miti"
    },
    "android": {
      "package": "com.uplixor.miti",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "miti",
              "host": "calendar"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF8EC"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#9B1C31"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MitiSmall",
              "label": "Miti — Today",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "description": "Nepali date, English date, and today's occasion",
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "MitiMedium",
              "label": "Miti — Month",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Browse Nepali month with festivals",
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "MitiLarge",
              "label": "Miti — Calendar",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "description": "Full Nepali month calendar",
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "miti-local"
      },
      "githubRepo": "palhimalaya/miti"
    }
  }
}
